# All settings are optional; defaults shown.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=20
ELEXON_MAX_RETRIES=3
CACHE_DIR=.cache
# Historical data is effectively immutable; refresh cached source data after this many hours.
CACHE_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Optional regex of extra allowed origins (e.g. Vercel previews): ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=
# Public URL of the frontend, shown at GET /
FRONTEND_URL=http://localhost:5173/
